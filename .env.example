# ─────────────────────────────────────────────────────────────────────────
# Local Development Environment
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in any secrets.
#   cp .env.example .env
#
# Services run on these ports by default:
#   API Gateway   :8080
#   User Service  :8081
#   Match Service :8082
#   Chat Service  :8083
#   Location Svc  :8084
#   Web Frontend  :3000

# ─── API Gateway ────────────────────────────────────────────────────────
# PORT=8080
# USER_SERVICE_URL=http://user-service:8081
# MATCH_SERVICE_URL=http://match-service:8082
# CHAT_SERVICE_URL=http://chat-service:8083
# LOCATION_SERVICE_URL=http://location-service:8084

# Auth — Clerk JWT validation (production)
# CLERK_JWT_ISSUER=https://your-clerk-domain.clerk.accounts.dev

# Auth — JWT signing key for development
# In production: set to the Clerk JWKS public key (PEM-encoded RSA).
# In development: set to the same value as DEV_JWT_SECRET in web/src/lib/auth.ts
#   so that loginSimulated() tokens pass validation end-to-end.
CLERK_JWT_KEY=dev-jwt-secret-do-not-use-in-production

# ─── User Service ───────────────────────────────────────────────────────
# PORT=8081
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/users?sslmode=disable
# S3_BUCKET=
# S3_REGION=

# Google OAuth (required for production login flow)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URL=http://localhost:8080/v1/auth/google/callback

# JWT secret for user-service issued tokens
# JWT_SECRET=change-me-in-production

# ─── Match Service ─────────────────────────────────────────────────────
# PORT=8082
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/matches?sslmode=disable
# USER_SERVICE_URL=http://user-service:8081
# KAFKA_BROKERS=kafka:9092

# ─── Chat Service ───────────────────────────────────────────────────────
# PORT=8083
# SCYLLA_URL=scylladb://chat-db:9042/chat
# REDIS_URL=redis:6379
# KAFKA_BROKERS=kafka:9092

# ─── Location Service ───────────────────────────────────────────────────
# PORT=8084
# REDIS_URL=redis:6379
# DATABASE_URL=postgres://postgres:postgres@location-db:5432/locations?sslmode=disable

# ─── Web Frontend (Next.js) ─────────────────────────────────────────────
# URL of the API Gateway (used by all API clients and WebSocket connections)
# NEXT_PUBLIC_API_URL=http://localhost:8080
